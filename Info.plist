<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleName</key>
    <string>SuperRightClick</string>
    <key>CFBundleDisplayName</key>
    <string>超级右键</string>
    <key>CFBundleIdentifier</key>
    <string>com.superrightclick.app</string>
    <key>CFBundleExecutable</key>
    <string>SuperRightClick</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <!-- 本地化声明：**必须**。系统对话框（NSOpenPanel 的按钮、侧边栏文字等）按 App 的
         本地化列表取语言；不声明的话只能回退到开发区域（默认 en），中文系统上也会显示英文。
         实测：不声明 → 中文系统解析成 ["en"]；声明后 → ["zh_CN"]。 -->
    <key>CFBundleDevelopmentRegion</key>
    <string>zh_CN</string>
    <key>CFBundleLocalizations</key>
    <array>
        <string>zh_CN</string>
        <string>en</string>
    </array>
    <key>CFBundleShortVersionString</key>
    <string>1.1.25</string>
    <key>CFBundleVersion</key>
    <string>29</string>
    <key>CFBundleIconFile</key>
    <string>AppIcon</string>
    <key>LSMinimumSystemVersion</key>
    <string>13.0</string>
    <key>LSUIElement</key>
    <true/>
    <key>NSHighResolutionCapable</key>
    <true/>
    <key>NSAppleEventsUsageDescription</key>
    <string>超级右键需要控制“访达”以读取选中文件并执行文件操作。</string>
</dict>
</plist>
